{
  "name": "flecha-language",
  "displayName": "Flecha Language Support",
  "description": "Syntax highlighting and editing support for Flecha source files.",
  "version": "0.1.0",
  "publisher": "flecha",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "flecha",
        "aliases": [
          "Flecha",
          "flecha"
        ],
        "extensions": [
          ".fl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "flecha",
        "scopeName": "source.flecha",
        "path": "./syntaxes/flecha.tmLanguage.json"
      }
    ]
  }
}
