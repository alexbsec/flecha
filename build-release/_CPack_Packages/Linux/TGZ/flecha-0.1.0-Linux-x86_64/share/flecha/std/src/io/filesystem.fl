module filesystem;

@imports :: root::io::errors;

extern unsafe i32 flecha_runtime_v1_read_file(
    *string output,
    *const char path,
    usize path_length
);

export (string, error) read_file(stringv path) {
    string output = none;
    unsafe {
        i32 status = flecha_runtime_v1_read_file(
            &raw output,
            path.data(),
            path.len().cast<usize>
        );
        if status == 0 {
            return (output, none);
        }
        if status == 1 {
            return (none, errors::IoError.NotFound);
        }
        if status == 2 {
            return (none, errors::IoError.PermissionDenied);
        }
        if status == 3 {
            return (none, errors::IoError.InvalidPath);
        }
        if status == 5 {
            return (none, errors::IoError.TooLarge);
        }
        if status == 6 {
            return (none, AllocationError.OutOfMemory);
        }
        return (none, errors::IoError.ReadFailed);
    }
}
