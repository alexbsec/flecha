i32 main() {
    stdoutln((8 as i8).string());
    stdoutln((16 as i16).string());
    stdoutln(32.string());
    stdoutln((64 as i64).string());
    stdoutln((72 as isize).string());
    stdoutln((8 as u8).string());
    stdoutln((16 as u16).string());
    stdoutln((32 as u32).string());
    stdoutln((64 as u64).string());
    stdoutln((72 as usize).string());
    stdoutln((1.25 as f32).string());
    stdoutln(1.5.string());
    stdoutln(true.string());
    stdoutln(false.cast<string>);
    stdoutln('!'.string());
    return 42;
}
