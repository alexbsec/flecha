i32 check_none<T>(T zero, T nonzero) {
    if !(zero == none) || !(none == zero) || zero != none || none != zero {
        return 1;
    }

    if nonzero == none || none == nonzero || !(nonzero != none) || !(none != nonzero) {
        return 2;
    }

    if zero === none || none === zero || !(zero !== none) || !(none !== zero) {
        return 3;
    }

    if nonzero === none || none === nonzero || !(nonzero !== none) || !(none !== nonzero) {
        return 4;
    }

    if !(zero == ((none))) || !(((none)) == zero) {
        return 5;
    }

    return 42;
}

i32 tick(&i32 count) {
    *count = *count + 1;
    return 0;
}

i32 none_comparison_test() {
    if check_none<i8>(0, -1) != 42 {
        return 1;
    }

    if check_none<u8>(0, 255) != 42 {
        return 2;
    }

    if check_none<i16>(0, -42) != 42 {
        return 3;
    }

    if check_none<u16>(0, 42) != 42 {
        return 4;
    }

    if check_none<i32>(0, -42) != 42 {
        return 5;
    }

    if check_none<u32>(0, 42) != 42 {
        return 6;
    }

    if check_none<i64>(0, -42) != 42 {
        return 7;
    }

    if check_none<u64>(0, 42) != 42 {
        return 8;
    }

    if check_none<isize>(0, -42) != 42 {
        return 9;
    }

    if check_none<usize>(0, 42) != 42 {
        return 10;
    }

    if check_none<f32>(-0.0 as f32, 1.25 as f32) != 42 {
        return 11;
    }

    if check_none<f64>(-0.0, 1.25) != 42 {
        return 12;
    }

    if check_none<bool>(false, true) != 42 {
        return 13;
    }

    if check_none<char>('\0', 'x') != 42 {
        return 14;
    }

    if !(none == none) || none != none || !(none === none) || none !== none {
        return 15;
    }

    i32 count = 0;
    if tick(&count) != none || none != tick(&count) {
        return 16;
    }

    if tick(&count) === none || none === tick(&count) {
        return 17;
    }

    if !(tick(&count) !== none) || !(none !== tick(&count)) || count != 6 {
        return 18;
    }

    return 42;
}
