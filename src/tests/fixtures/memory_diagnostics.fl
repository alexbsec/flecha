// Intentionally invalid: the compiler must reject this before object emission.
unsafe void leaking(bool early) {
    p, err := new<u8>(42);
    if err != none { return; }
    if early { return; }
    free(p);
}

unsafe void invalid_alias() {
    p, err := new<u8>(42);
    if err != none { return; }
    alias := p;
    free(p);
    *alias = 7;
    free(alias);
}

unsafe void invalid_lending(lend *u8 pointer) {
    free(pointer);
}
unsafe void missing_cleanup(own *u8 pointer) {}
