module lifecycle;

@imports :: lib::std::containers::array;

i32 early_return() {
    values := array::Array<i32>::init();
    if values.push(42) != none {
        return 1;
    }

    return 0;
}

i32 main() {
    empty := array::Array<i32>::init();
    if empty.len() != 0 || empty.capacity() != 0 {
        return 1;
    }

    usize i = 0;
    while i < 10 {
        {
            values := array::Array<i32>::init();
            if values.push(42) != none {
                return 2;
            }
        }

        if early_return() != 0 {
            return 3;
        }

        i++;
    }

    return 42;
}
