unsafe void record(*i32 trace, i32 digit) {
    *trace = *trace * 10 + digit;
}
void set_value(&i32 target, i32 value) { *target = value; }
void set_slice([]i32 target, i32 value) { target[0] = value; }
unsafe i32 next_digit(*i32 count) { (*count)++; return *count; }
unsafe void pair(*i32 trace, i32 first, i32 second) {
    record(trace, first);
    record(trace, second);
}
unsafe i32 returning(*i32 trace) {
    defer record(trace, 1);
    {
        defer record(trace, 2);
        return *trace;
    }
}

i32 defer_order_test() {
    i32 trace = 0;
    unsafe {
        defer record(&raw trace, 1);
        {
            defer record(&raw trace, 2);
            defer record(&raw trace, 3);
            record(&raw trace, 4);
        }
        if trace != 432 { return 1; }
    }
    if trace != 4321 { return 2; }
    trace = 7;
    unsafe {
        if returning(&raw trace) != 7 { return 3; }
    }
    if trace != 721 { return 4; }
    trace = 0;
    i32 argument = 4;
    i32 count = 0;
    unsafe {
        defer record(&raw trace, argument);
        argument = 9;
        defer pair(&raw trace, next_digit(&raw count), next_digit(&raw count));
        if count != 2 or trace != 0 { return 5; }
        if false { defer record(&raw trace, 9); }
    }
    if trace != 124 { return 6; }
    { defer set_value(&trace, 42); }
    if trace != 42 { return 7; }
    a := [1, 2];
    { defer set_slice(a[:], 42); }
    if a[0] != 42 { return 8; }
    return 42;
}

i32 defer_loop_test() {
    i32 trace = 0;
    unsafe {
        loop i := 1; i <= 4; i++ {
            defer record(&raw trace, i);
            if i == 1 { proceed; }
            if i == 3 { break; }
        }
    }
    if trace != 123 { return 1; }
    trace = 0;
    unsafe {
        for (_, value) := range [4, 5, 6] {
            defer record(&raw trace, value);
            if value == 5 { proceed; }
        }
    }
    if trace != 456 { return 2; }
    trace = 0;
    i32 i = 0;
    unsafe {
        loop ; i < 3; record(&raw trace, 9) {
            i++;
            defer record(&raw trace, i);
            if i == 2 { proceed; }
            if i == 3 { break; }
        }
    }
    if trace != 19293 { return 3; }
    trace = 0;
    i = 0;
    unsafe {
        while i < 2 {
            i++;
            defer record(&raw trace, i);
        } also true {
            defer record(&raw trace, 8);
        }
    }
    if trace != 8182 { return 4; }
    return 42;
}

i32 defer_jump_test() {
    i32 trace = 0;
    i32 i = 0;
    unsafe {
        loop ;; {
            #again
            i++;
            defer record(&raw trace, i);
            if i < 3 { jumpto again; }
            if trace != 0 { return 1; }
            jumpto finish;
            defer record(&raw trace, 9);
            #finish
            break;
        }
    }
    if trace != 321 { return 2; }
    trace = 0;
    loop ;; {
        unsafe {
            defer record(&raw trace, 1);
            {
                defer record(&raw trace, 2);
                jumpto sibling;
            }
            {
                defer record(&raw trace, 9);
                #sibling
                defer record(&raw trace, 3);
                jumpto outside;
            }
            defer record(&raw trace, 8);
        }
        #outside
        break;
    }
    if trace != 231 { return 3; }
    trace = 0;
    i = 0;
    unsafe {
        loop ;; {
            #reenter
            {
                defer record(&raw trace, 4);
                i++;
                if i < 3 { jumpto reenter; }
            }
            break;
        }
    }
    if trace != 444 { return 4; }
    return 42;
}

unsafe void check_string(*i32 count, string value) {
    if value == "before" { (*count)++; }
}
unsafe void check_view(*i32 count, stringv value) {
    if value == "before" { (*count)++; }
}
unsafe void check_array(*i32 count, [3]i32 value) {
    if value[0] == 1 and value[2] == 3 { (*count)++; }
}
string owned_result() { return "discarded" + " result"; }
string deferred_string_return() {
    string value = "before";
    defer stdout("");
    defer owned_result();
    return value;
}
i32 defer_capture_test() {
    i32 count = 0;
    string source = "before";
    a := [1, 2, 3];
    unsafe {
        defer check_string(&raw count, source);
        defer check_view(&raw count, source.view());
        defer check_view(&raw count, ("be" + "fore").view());
        defer check_array(&raw count, a);
        defer owned_result();
        source = "after";
        a[0] = 9;
    }
    if count != 4 { return 1; }
    if deferred_string_return() != "before" { return 2; }
    count = 0;
    i32 i = 0;
    unsafe {
        loop ;; {
            #again
            defer check_view(&raw count, ("be" + "fore").view());
            i++;
            if i < 8 { jumpto again; }
            break;
        }
    }
    if count != 8 { return 3; }
    return 42;
}

unsafe void large_capture(*i32 count, [1024]i32 values) {
    *count = *count + values[1023];
}
i32 defer_stack_test() {
    i32 count = 0;
    unsafe {
        loop i := 0; i < 100000; i++ {
            defer large_capture(&raw count, [1; 1024]);
            defer owned_result();
            if i < 99999 { proceed; }
            break;
        }
    }
    if count != 100000 { return 1; }
    return 42;
}

i32 fail_bounds(usize index) { a := [1]; return a[index]; }
void defer_trap_test(usize index) {
    defer stdoutln("must not unwind a trap");
    fail_bounds(index);
}
void defer_argument_trap_test(usize index) {
    defer stdoutln("must not unwind a failed registration");
    defer stdoutln(fail_bounds(index));
}
void defer_cleanup_trap_test(usize index) {
    defer stdoutln("must not execute after deferred callee traps");
    defer fail_bounds(index);
}
