module array_i32;

export error ArrayError { Empty, IndexOutOfBounds }

// The first standard-library array specializes i32 until generics are available.
// All allocated slots contain initialized integers; length marks the used prefix.
export structure I32Array {
    private own *i32 storage;
    private usize length;
    private usize allocated;
};

unsafe I32Array I32Array::init() override {
    return build I32Array {};
}

unsafe void I32Array::tear(&self) override {
    free(self->storage);
}

usize I32Array::len(&const self) { return self->length; }
usize I32Array::capacity(&const self) { return self->allocated; }

unsafe error I32Array::reserve(&self, usize capacity) {
    if capacity <= self->allocated { return none; }
    replacement, err := new<[]i32>(capacity);
    if err != none { return err; }

    usize i = 0;
    while i < self->length {
        replacement[i] = self->storage[i];
        i++;
    }
    previous := take(self->storage);
    free(previous);
    self->storage = replacement;
    self->allocated = capacity;
    return none;
}

unsafe error I32Array::push(&self, i32 value) {
    if self->length == self->allocated {
        usize capacity = 4;
        if self->allocated != 0 {
            capacity = self->allocated * 2;
            if capacity <= self->allocated { return AllocationError.OutOfMemory; }
        }
        err := self->reserve(capacity);
        if err != none { return err; }
    }
    self->storage[self->length] = value;
    self->length++;
    return none;
}

unsafe (i32, error) I32Array::get(&const self, usize index) {
    if index >= self->length { return (0, ArrayError.IndexOutOfBounds); }
    return (self->storage[index], none);
}

unsafe error I32Array::set(&self, usize index, i32 value) {
    if index >= self->length { return ArrayError.IndexOutOfBounds; }
    self->storage[index] = value;
    return none;
}

unsafe (i32, error) I32Array::pop(&self) {
    if self->length == 0 { return (0, ArrayError.Empty); }
    self->length = self->length - 1;
    return (self->storage[self->length], none);
}

void I32Array::clear(&self) { self->length = 0; }
