// Intentionally rejected: reference execution and pointer casts remain unsupported.
// Check: build/flecha --emit-llvm examples/diagnostics/compound_types.fl
// For executable pointer examples, see examples/unsafe_pointers.fl.

// Every reference type below reports FLECHA-S0024.
void reference_types(
    &u8 writable,
    &const u8 readOnly,
    constref u8 fixedAlias,
    const &u8 fixedExpanded,
    constref const u8 fixedReadOnlyAlias,
    const &const u8 fixedReadOnlyExpanded
) {}

void nested_references(
    &*u8 referenceToPointer,
    &constptr u8 referenceToFixedPointer,
    *&u8 pointerToReference
) {}

void unsupported_casts() {
    0 as *u8;                // FLECHA-S0017: integer-to-pointer cast rejected.
    0.cast<constref u8>;      // FLECHA-S0024: reference type not yet executable.
}

// Aliases already include const on their own layer. These cause parser errors:
// const constptr u8 duplicatePointer;
// const constref u8 duplicateReference;
// const const i32 duplicateValue = 42;
