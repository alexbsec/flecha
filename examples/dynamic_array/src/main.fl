module main;

@imports
    :: lib::std::containers::raw_array;

i32 main() {
    unsafe {
        numbers := raw_array::RawArray<i32>::init();

        i32 i = 0;
        while i < 100 {
            err := numbers.push(i);
            if err != none {
                return 1;
            }
            i++;
        }

        value, err := numbers.get(42);
        if err != none {
            return 2;
        }

        stdout("RawArray length: ");
        stdoutln(numbers.len());
        stdout("Element 42: ");
        stdoutln(value);
        return value;
    }
}
